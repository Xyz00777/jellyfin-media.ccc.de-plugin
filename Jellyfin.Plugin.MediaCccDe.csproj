    <RootNamespace>Jellyfin.Plugin.MediaCccDe</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.MediaCccDe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.*">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
