#!/usr/bin/env bash
# direnv setup for Jellyfin Media.CCC.de Plugin
# Usage: install direnv and nix, then run `direnv allow`

if ! command -v nix &> /dev/null; then
    echo "WARNING: nix not found. Install nix first: https://nixos.org/download"
    return
fi

# Use flake.nix dev shell
eval "$(nix print-dev-env --impure --show-trace path:. 2>/dev/null)"